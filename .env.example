# CodingPortal Credentials
PORTAL_USERNAME=your_username_here
PORTAL_PASSWORD=your_password_here

# Nebius Token Factory Configuration (Required for Nebius x NVIDIA Hackathon)
USE_NEBIUS=true
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA NIM API (Alternative/Fallback)
USE_NVIDIA=true
NVIDIA_API_KEY=your_nvidia_api_key_here
FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
THINKING_MODEL=nvidia/nemotron-3-super-120b-a12b

# Gemini Configuration (Fallback/Retry Model)
USE_GEMINI=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Ollama (local fallback)
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Automation Settings
TYPING_DELAY_MS=5
RUN_WAIT_SECONDS=8
NEXT_WAIT_SECONDS=3
MAX_RETRIES=4
